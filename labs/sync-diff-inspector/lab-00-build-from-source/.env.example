# Source repository and local checkout
TIFLOW_REPO=https://github.com/pingcap/tiflow.git
# TIFLOW_DIR=/absolute/path/to/a/dedicated/tiflow-checkout

# Source selectors. Explicit environment values and positional arguments override .env.
PR_NUMBER=12804
TIFLOW_BRANCH=master

# Reproducible Go builder. Override only when deliberately validating another toolchain.
BUILDER_IMAGE=golang:1.25.12-bookworm@sha256:6359592445455f2dbe2412bed411336035bc019a50017720d77454ffdd6d0f82

# Artifact target
TARGET_OS=linux
TARGET_ARCH=amd64

# Generated output locations. Use absolute paths for custom locations.
# DIST_DIR=/absolute/path/to/generated-artifacts
# RESULTS_DIR=/absolute/path/to/generated-logs

# Optional fixed UTC run timestamp for repeatable filenames.
# TS=20260817T214500Z

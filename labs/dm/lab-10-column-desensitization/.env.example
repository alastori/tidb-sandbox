# Lab 10 - Column Desensitization Workarounds
# Copy to .env and customize if needed

# Versions
MYSQL_IMAGE=mysql:8.0.44
TIDB_VERSION=v8.5.4
DM_VERSION=v8.5.4

# MySQL root password
MYSQL_ROOT_PASSWORD=Pass_1234

# Encryption key (lab-only, NOT for production)
# WARNING: In production, use application-layer encryption with KMS.
# Database-side keys in triggers are visible in SHOW CREATE TRIGGER,
# information_schema.TRIGGERS, and binlog events.
ENCRYPT_KEY=lab10-secret-key

# Health check tuning
MAX_RETRIES=30
RETRY_INTERVAL=2
